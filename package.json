{
  "name": "apicuron-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start-dev": "cross-env NODE_ENV=development ng serve",
    "start-dev-external": "ng serve --host 0.0.0.0 --disableHostCheck",
    "start-prod": "ng serve --configuration production",
    "build": "rm -rf dist/* && ng build --configuration production --build-optimizer",
    "deploy-dev": "(colC='\\033[0;36m';colN='\\033[0m'; echo ${colC}Running npm build ...${colN} && npm run build && echo ${colC}Rsyncing dist ...${colN} && rsync -avzh --delete dist biocomp@persefone:/var/www/apicuron-dev/ && echo ${colC}Done with deploy-dev!${colC})",
    "deploy-prod": "(colC='\\033[0;36m';colN='\\033[0m'; echo ${colC}Running npm build ...${colN} && npm run build && echo ${colC}Rsyncing dist ...${colN} && rsync -avh --delete dist biocomp@persefone:/var/www/apicuron/ && echo ${colC}Done with deploy-prod!${colC})",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^14.2.3",
    "@angular/cdk": "^13.3.9",
    "@angular/common": "^14.2.3",
    "@angular/compiler": "^14.2.3",
    "@angular/core": "^14.2.3",
    "@angular/forms": "^14.2.3",
    "@angular/platform-browser": "^14.2.3",
    "@angular/platform-browser-dynamic": "^14.2.3",
    "@angular/router": "^14.2.3",
    "@ngneat/tailwind": "^7.0.3",
    "@nicky-lenaers/ngx-scroll-to": "^9.0.0",
    "bootstrap": "^4.5.2",
    "core-js": "^2.5.4",
    "EBI-Icon-fonts": "^1.3.1",
    "material-design-icons": "^3.0.1",
    "moment": "^2.29.4",
    "ngx-bootstrap": "^5.6.2",
    "ngx-toastr": "^15.2.0",
    "rxjs": "~6.6.3",
    "swagger-ui": "^3.52.3",
    "swiper": "^8.3.2",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^11.1.1",
    "@angular-devkit/build-angular": "^14.2.3",
    "@angular-devkit/core": "^14.2.3",
    "@angular/cli": "^14.2.3",
    "@angular/compiler-cli": "^14.2.3",
    "@angular/language-service": "^14.2.3",
    "@tailwindcss/forms": "latest",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^12.11.1",
    "autoprefixer": "^10.4.7",
    "codelyzer": "^6.0.0",
    "cross-env": "^7.0.3",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.19",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "postcss": "^8.4.13",
    "protractor": "~7.0.0",
    "tailwindcss": "^3.1.8",
    "ts-node": "~7.0.0",
    "tslint": "~6.1.0",
    "typescript": "~4.6.4"
  }
}
