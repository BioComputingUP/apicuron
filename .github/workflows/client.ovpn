client
dev tun
proto tcp-client
remote 147.162.172.248 1194
nobind
persist-key
persist-tun
cipher AES-256-CBC
auth SHA1
pull
verb 2
mute 3
auth-user-pass user.auth
ca cert_export_geras.crt
cert cert_export_adel@geras.crt
key cert_export_adel@geras.key
remote-cert-tls server
route 172.21.2.0 255.255.255.0
route 172.16.1.0 255.255.255.252
route 10.69.69.0 255.255.255.0
route 10.66.66.0 255.255.255.0
route 147.162.172.244 255.255.255.252
route 147.162.3.10 255.255.255.255
script-security 2
up /etc/openvpn/update-resolv-conf
down /etc/openvpn/update-resolv-conf
dhcp-option DOMAIN local
dhcp-option DOMAIN-ROUTE .
