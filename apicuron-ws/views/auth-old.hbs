<body class="">

    <div class="tw-flex tw-w-full tw-flex-row tw-flex-wrap">
        <img class="tw-w-96" src="/assets/APICURON.svg" alt="">
        <h2 class="tw-text-xl tw-text-gray-700 tw-font-bold tw-font-sans">Login Successfull !</h2>

    </div>




    <button>Close</button>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>

        const accessTokenElement: HTMLMetaElement = document.head.querySelector(
            "[name=access_token][content]"
        );

        const msg = {
            access_token: accessTokenElement.content,
        };
        console.log(msg);

        [environment.ws, environment.host].map((url: string) => {
            const origin = new URL(url).origin;
            window?.opener.postMessage(msg, origin);
        })
    </script>

</body>

