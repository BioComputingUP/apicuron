{
  "name": "apicuron-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start-dev": "cross-env NODE_ENV=development ng serve",
    "start-dev-external": "ng serve --host 0.0.0.0 --disable-host-check",
    "start-prod": "ng serve --configuration production",
    "compodoc": "npx compodoc -p tsconfig.doc.json",
    "build": "rm -rf dist/* && npm run build-widget && ng build apicuron-ui --configuration production",
    "build-widget-dev": "npx ng build leaderboard --configuration=development --build-optimizer --output-hashing=none",
    "build-widget": "npx ng build leaderboard --configuration=production --build-optimizer --output-hashing=none",
    "watch-widget": "npx ng serve leaderboard --configuration=local",
    "build-dev": "rm -rf dist/* && npm run build-widget-dev &&  ng build apicuron-ui --configuration development --source-map",
    "deploy-dev": "(colC='\\033[0;36m';colN='\\033[0m'; echo ${colC}Running npm build-dev ...${colN} && npm run build-dev && echo ${colC}Rsyncing dist ...${colN} && rsync -avzh --delete dist biocomp@persefone:/var/www/apicuron-dev/ && echo ${colC}Done with deploy-dev!${colC})",
    "deploy-prod": "(colC='\\033[0;36m';colN='\\033[0m'; echo ${colC}Running npm build ...${colN} && npm run build && echo ${colC}Rsyncing dist ...${colN} && rsync -avh --delete dist biocomp@persefone:/var/www/apicuron/ && echo ${colC}Done with deploy-prod!${colC})",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "compodoc:build": "compodoc -p tsconfig.doc.json",
    "compodoc:build-and-serve": "compodoc -p tsconfig.doc.json -s",
    "compodoc:serve": "compodoc -s",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org apicuron --project apicuron-ui ./dist/apicuron-ui/ && sentry-cli sourcemaps upload --org apicuron --project apicuron-ui ./dist/apicuron-ui/",
    "dev:ssr": "ng run apicuron-ui:serve-ssr",
    "serve:ssr": "node dist/apicuron-ui/server/main.js",
    "build:ssr": "ng build && ng run apicuron-ui:server",
    "prerender": "ng run apicuron-ui:prerender",
    "prerender-dev": "ng run apicuron-ui:prerender:development",
    "prerender-prod": "ng run apicuron-ui:prerender:production"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/elements": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/material": "^17.3.10",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/platform-server": "^17.3.12",
    "@angular/router": "^17.3.12",
    "@angular/ssr": "^17.3.12",
    "@ngneat/tailwind": "^7.0.3",
    "@sentry/angular-ivy": "^7.73.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/lodash": "^4.14.194",
    "@types/plotly.js-dist-min": "^2.3.1",
    "EBI-Icon-fonts": "^1.3.1",
    "anchor-js": "^4.3.1",
    "angular-svg-icon": "^16.1.0",
    "chart.js": "^4.4.3",
    "cookieconsent": "^3.1.1",
    "core-js": "^2.5.4",
    "express": "^4.15.2",
    "install": "^0.13.0",
    "lodash": "^4.17.21",
    "marked": "^12.0.0",
    "material-design-icons": "^3.0.1",
    "moment": "^2.29.4",
    "moment-range": "^4.0.2",
    "ngx-cookieconsent": "^6.0.0",
    "ngx-markdown": "^17.2.1",
    "ngx-matomo-client": "^6.4.1",
    "ngx-toastr": "^16.2.0",
    "npm": "^9.7.1",
    "ordinal": "^1.0.3",
    "plotly.js-dist-min": "^2.18.1",
    "primeicons": "^6.0.1",
    "primeng": "^17.18.15",
    "primeng-sass-theme": "github:primefaces/primeng-sass-theme",
    "rxjs": "^7.4.0",
    "swiper": "^8.3.2",
    "tslib": "^2.3.1",
    "zone.js": "^0.14.3"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^17.0.2",
    "@angular-devkit/build-angular": "^17.3.12",
    "@angular-devkit/core": "^17.3.12",
    "@angular/cli": "^17.3.12",
    "@angular/compiler-cli": "^17.3.12",
    "@angular/language-service": "^17.3.12",
    "@faker-js/faker": "^9.5.0",
    "@sentry/cli": "^2.21.2",
    "@tailwindcss/forms": "latest",
    "@tailwindcss/typography": "^0.5.8",
    "@types/express": "^4.17.0",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^18.11.18",
    "autoprefixer": "^10.4.7",
    "browser-sync": "^3.0.0",
    "cross-env": "^7.0.3",
    "jasmine-core": "3.8",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.19",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "ng-packagr": "^17.3.0",
    "postcss": "^8.4.13",
    "protractor": "~7.0.0",
    "tailwindcss": "^3.3.3",
    "ts-node": "~7.0.0",
    "tslint": "~6.1.0",
    "typescript": "~5.4.5",
    "webpack": "^5.95.0",
    "webpack-sources": "^3.2.3"
  }
}
