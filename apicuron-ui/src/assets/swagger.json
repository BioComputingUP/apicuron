  "paths": {
    "/leaderboards": {
      "get": {
        "tags": [
          "Public API"
        ],
        "description": "Retrieve ranking and scores",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "curator_orcid",
            "in": "query",
            "type": "string",
            "description": "Biocurator ORCID"
          },
          {
            "name": "curator_name",
            "in": "query",
            "type": "string",
            "description": "Biocurator name"
          },
          {
            "name": "resource_uri",
            "in": "query",
            "type": "string",
            "description": "Resource unique identifier (URI)"
          },
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "description": "Number of items to return"
          },
          {
            "name": "skip",
            "in": "query",
            "type": "integer",
            "description": "Number of items to skip (useful for pagination)"
          },
          {
            "name": "format",
            "in": "query",
            "description": "The output format. By default it returns a json stream. If explicitly format=json it returns a json file",
            "type": "string",
            "enum": [
              "json",
              "tsv"
            ]
          }

        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/leaderboard"
              }
            }
          }
