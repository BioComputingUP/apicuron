# Use for local development only
# GID=1001
# UID=1001
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGODB_USER=
MONGODB_PASSWORD=
DATABASE_HOST=mongodb
DATABASE=apicuron
DB_PORT=27017
# production, development, local
NODE_ENV=production

# GitHub personal access token for syncing GitHub identities (used for ID to GitHub username mapping)
# if not setup, it falls back to unauthenticated GitHub API requests, which are rate limited to 60 requests per hour
# Token was generated with 
# github.com -> settings -> developer settings -> fine grained tokens -> new token (public repositories, no permissions needed, expiration: 1 year)
GITHUB_TOKEN=