        },

        "activity_category": {
          "type": "string",
          "example": "",
          "description": ""
        },
        "activity_name": {
          "type": "string",
          "example": "",
          "description": ""
        },
        "activity_term": {
          "type": "string",
          "example": "",
          "description": ""
        },
        "description": {
          "type": "string",
          "example": "",
          "description": ""
        },
        "score": {
          "type": "string",
          "example": "",
          "description": ""
        },
        "curator_orcid": {
          "type": "string",
          "example": "0000-0001-6859-3648",
          "description": "The ORCID iD of the biocurator"
        },
        "entity_uri": {
          "type": "string",
          "example": "",
