{
    "version": "0.2.0",
    "configurations": [

        {
            "type": "node",
            "request": "attach",
            "name": "Attach NestJS WS",
            "port": 9229,
            "restart": true,
            "stopOnEntry": false,
            "protocol": "inspector"
          },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Nest Framework",
            "args": [
                "${workspaceFolder}/src/main.ts"
            ],
            "runtimeArgs": [
                "--nolazy",
                "-r",
                "ts-node/register"
            ],
            "sourceMaps": true,
            "envFile": "${workspaceFolder}/.env",
            "runtimeExecutable": "node",
            "cwd": "${workspaceRoot}",
            "console": "integratedTerminal",
            "protocol": "inspector"
        },

        {
            "type": "node",
            "request": "launch",
            "name": "Debug Compute Badges",
            "outFiles": [],
            "args": [
                "${workspaceFolder}/src/scripts/compute-badges.ts"
            ],
            "runtimeArgs": [
                "--nolazy",
                "-r",
                "ts-node/register"
            ],
            "sourceMaps": true,
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "NODE_ENV": "local"
            },
            "runtimeExecutable": "node",
            "cwd": "${workspaceRoot}",
            "console": "integratedTerminal",
            "protocol": "inspector"
        },
    ]
  }