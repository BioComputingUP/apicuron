<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico">
    <meta name="msapplication-TileColor" content="#9a031e">

    <meta name="access_token" content="{{ access_token }}">
    <meta name="refresh_token" content="{{ refresh_token }}">
    <title>Login Confirmation</title>
    <style>
        /* Reset some default styles */
        body,
        html {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            color: rgb(55 65 81);
        }

        /* Center the content vertically and horizontally */
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-color: #f0f0f0;
        }

        /* Content container */
        .container {
            max-width: 400px;
            padding: 20px;
            background-color: #fff;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
            border-radius: 8px;
        }

        /* Heading */
        h1 {
            text-align: center;
            margin: 0 0 20px;
        }

        /* Confirmation message */
        .message {
            text-align: center;
            margin-bottom: 20px;
        }

        /* Login confirmation icon */
        .icon {
            text-align: center;
            font-size: 48px;
            margin-bottom: 20px;
        }

        /* Button styles */
        .btn {
            width: 100%;
            display: block;
            padding: 12px 16px;
            text-align: center;
            text-decoration: none;
            background-color: #4D194D;
            /* Updated button color */
            color: #fff;
            font-size: 16px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        .btn:hover {
            background-color: #3B143B;
            /* Slightly darker color on hover */
        }

        /* Responsive adjustments */
        @media (max-width: 480px) {
            .container {
                max-width: 100%;
                border-radius: 0;
            }
        }

        .logo {
            display: block;
            margin: auto;
        }
        #redirection_tab{
            display: none;
            text-align: center;
            padding-bottom: 1rem;
        }
    </style>
</head>

<body>
    <div class="container">
        <img class="logo" src="/assets/APICURON.svg" alt="">
        <div class="icon">✓</div>
        <h1>Login Successful</h1>
        <div class="message">You have successfully logged in!</div>
        <div id="redirection_tab">
            You will be redirected to APICURON homepage in 
        </div>
        <button onclick="self.close();" class="btn">Close</button>
    </div>


    <script>

        window.onload = function () {
            const accessTokenElement = document.head.querySelector(
                "[name=access_token][content]"
            );

            const msg = {
                access_token: accessTokenElement.content,
            };

            function setCounter(element, number){
                element.innerHTML = "You will be redirected to APICURON homepage in " + number+ ' <br> if redirection fails, <a href="/">click here</a>';

            }

            // window.opener?.postMessage('oauthsetup', window.location.origin);
            if(window.opener){
                window.opener?.postMessage(msg, window.location.origin);           
            }else{

                const redirectionBlock = document.body.querySelector('#redirection_tab')
                let intervalCount = 5
                setCounter(redirectionBlock, intervalCount)
                redirectionBlock.style.display = "block"
                
                const interVId = setInterval(() => {
                    intervalCount--;
                    setCounter(redirectionBlock, intervalCount)
                    if(intervalCount == 0){
                        clearInterval(interVId)
                    }
                }, 1000)

                localStorage.setItem('orcid-token',msg.access_token)
                
                setTimeout(() => {
                window.location.href = '/'
                }, 1000)
            }
            
        }


    </script>
</body>

</html>